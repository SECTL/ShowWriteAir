                                <Rectangle Style="{StaticResource ColorRectangleStyle}" Fill="Pink"/>
                                <Path x:Name="CheckIcon_Pink" Style="{StaticResource CheckIconStyle}"/>
                            </Grid>
                        </Button>
                        <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource PenSettingsButtonStyle}" 

                        <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource PenSettingsButtonStyle}" 
                                Click="ColorButton_Click" Tag="Brown" ToolTip="{Binding Source={x:Static services:LanguageManager.Instance}, Path=Translations[Brown]}">

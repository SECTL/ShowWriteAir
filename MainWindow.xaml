                                       Text="{Binding Source={x:Static services:LanguageManager.Instance}, Path=Translations[ShowVirtualAdapters]}"
                                       Foreground="{DynamicResource TextBrush}" FontSize="11"
                                       VerticalAlignment="Center" Margin="2,0,0,0" Cursor="Hand"
                                       MouseLeftButtonDown="ShowVirtualAdaptersLabel_MouseLeftButtonDown"/>
                            <!-- 提示图标：单击显示提示悬浮框 -->
                            <Border x:Name="VirtualAdapterTipIcon" Width="12" Height="12" Margin="4,0,0,0"
                                    Background="Transparent" Cursor="Hand" VerticalAlignment="Center"
                                    MouseLeftButtonDown="VirtualAdapterTipIcon_MouseLeftButtonDown">
                                <Viewbox Width="12" Height="12">
                                    <Path Fill="{DynamicResource TextBrush}" Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 15c-.55 0-1-.45-1-1v-4c0-.55.45-1 1-1s1 .45 1 1v4c0 .55-.45 1-1 1zm0-8c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1z"/>
                                </Viewbox>
                            </Border>
                        </StackPanel>

                        <!-- 热点设置：SSID 模式选择 + 密码（横向排列） -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Source={x:Static services:LanguageManager.Instance}, Path=Translations[HotspotSSID]}"
                                       Foreground="{DynamicResource TextBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

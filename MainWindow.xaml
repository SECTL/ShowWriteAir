                                    <TextBlock x:Name="RefreshButtonText" Text="{Binding Source={x:Static services:LanguageManager.Instance}, Path=Translations[Refresh]}" FontSize="10" HorizontalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- 网卡设置：标题+下拉框横向排列 -->
                        <Grid Margin="0,0,0,8">

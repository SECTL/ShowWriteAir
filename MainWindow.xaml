                                         TextChanged="HotspotCustomSsidText_TextChanged"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Source={x:Static services:LanguageManager.Instance}, Path=Translations[HotspotPassword]}"
                                       Foreground="{DynamicResource TextBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="HotspotPasswordText" Grid.Column="1" Width="120" Height="30" FontSize="11"
                                     VerticalContentAlignment="Center" HorizontalAlignment="Left"
                                     TextChanged="HotspotPasswordText_TextChanged"/>
                        </Grid>

                        <!-- 返回按钮 -->
                        <Button x:Name="ConnectDeviceBackBtn" Click="ConnectDeviceBackBtn_Click"
                                HorizontalAlignment="Center" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent" Padding="4">
                                        <Viewbox Width="16" Height="16">
                                            <Path Fill="{DynamicResource TextBrush}" Data="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
                                        </Viewbox>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                    </StackPanel>

                    <!-- 左侧：已连接设备列表（点击已连接设备数徽章向左展开/收起） -->
                    <Border x:Name="ConnectedDeviceListPanel" Grid.Column="0" Visibility="Collapsed"
                            VerticalAlignment="Stretch" Margin="0,0,15,0"
                            BorderBrush="{DynamicResource PopupBorder}" BorderThickness="0,0,1,0">
                        <StackPanel Width="200">
                            <!-- 标题：居中于展开窗口 -->
                            <TextBlock Text="{Binding Source={x:Static services:LanguageManager.Instance}, Path=Translations[ConnectedDevices]}"

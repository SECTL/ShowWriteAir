                            <Grid Style="{StaticResource ColorButtonContainerStyle}">
                                <Rectangle Style="{StaticResource ColorRectangleStyle}" Fill="Gray"/>
                                <Path x:Name="CheckIcon_Gray" Style="{StaticResource CheckIconStyle}"/>

                                       HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <!-- 设备列表 -->
                            <ItemsControl x:Name="ConnectedDeviceListItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource PopupBorder}" CornerRadius="4"
                                                Padding="8,6" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Model}" Foreground="{DynamicResource TextBrush}"
                                                           FontSize="12" FontWeight="Bold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Manufacturer}" Foreground="{DynamicResource TextBrush}"
                                                           FontSize="10" Opacity="0.7" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- 空状态：图片 + 提示文字 -->
                            <StackPanel x:Name="ConnectedDeviceEmptyPanel" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,20,0,0">
                                <Image Source="pack://application:,,,/images/nodevice.png"
                                       Width="120" Height="120" Stretch="Uniform" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="ConnectedDeviceEmptyText"
                                           Text="{Binding Source={x:Static services:LanguageManager.Instance}, Path=Translations[NoConnectedDevices]}"
                                           Foreground="{DynamicResource TextBrush}" FontSize="12" Opacity="0.6"
                                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Popup>

        <!-- 虚拟网卡提示悬浮框（单击图标显示，点击外部或图标关闭） -->
        <Popup x:Name="VirtualAdapterTipPopup" PlacementTarget="{Binding ElementName=VirtualAdapterTipIcon}"
               Placement="Right" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="{DynamicResource PopupBackground}" CornerRadius="4"
                    BorderBrush="{DynamicResource PopupBorder}" BorderThickness="1" Padding="8,5" MaxWidth="220">
                <TextBlock Text="{Binding Source={x:Static services:LanguageManager.Instance}, Path=Translations[ShowVirtualAdaptersTip]}"
                           Foreground="{DynamicResource TextBrush}" FontSize="11" TextWrapping="Wrap"/>
            </Border>
        </Popup>

        <!-- 画笔设置悬浮窗 -->

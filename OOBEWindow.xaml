<Window x:Class="ShowWriteAir.OOBEWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:WindowHelper.SystemBackdropType="Mica"
        Title="OOBE"
        Width="900" Height="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White">
    <Window.Resources>
        <!-- 缓动函数（必须在引用它的 Storyboard 之前定义） -->
        <QuarticEase x:Key="SlideEase" EasingMode="EaseOut"/>

        <!-- 标题滑入动画：四个标题从右至左依次滑入 -->
        <Storyboard x:Key="TitlesSlideInStoryboard">
            <!-- 标题1：欢迎 -->
            <DoubleAnimation Storyboard.TargetName="Title1Transform"
                             Storyboard.TargetProperty="X"
                             From="400" To="0"
                             BeginTime="0:0:0" Duration="0:0:0.5"
                             EasingFunction="{StaticResource SlideEase}"/>
            <DoubleAnimation Storyboard.TargetName="Title1"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1"
                             BeginTime="0:0:0" Duration="0:0:0.5"/>

            <!-- 标题2：基础 -->
            <DoubleAnimation Storyboard.TargetName="Title2Transform"
                             Storyboard.TargetProperty="X"
                             From="400" To="0"
                             BeginTime="0:0:0.2" Duration="0:0:0.5"
                             EasingFunction="{StaticResource SlideEase}"/>
            <DoubleAnimation Storyboard.TargetName="Title2"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1"
                             BeginTime="0:0:0.2" Duration="0:0:0.5"/>

            <!-- 标题3：个性化 -->
            <DoubleAnimation Storyboard.TargetName="Title3Transform"
                             Storyboard.TargetProperty="X"
                             From="400" To="0"
                             BeginTime="0:0:0.4" Duration="0:0:0.5"
                             EasingFunction="{StaticResource SlideEase}"/>
            <DoubleAnimation Storyboard.TargetName="Title3"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1"
                             BeginTime="0:0:0.4" Duration="0:0:0.5"/>

            <!-- 标题4：开始 -->
            <DoubleAnimation Storyboard.TargetName="Title4Transform"
                             Storyboard.TargetProperty="X"
                             From="400" To="0"
                             BeginTime="0:0:0.6" Duration="0:0:0.5"
                             EasingFunction="{StaticResource SlideEase}"/>
            <DoubleAnimation Storyboard.TargetName="Title4"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1"
                             BeginTime="0:0:0.6" Duration="0:0:0.5"/>
        </Storyboard>

        <!-- 内容区域淡入动画（在标题滑入完成后触发） -->
        <Storyboard x:Key="ContentFadeInStoryboard">
            <DoubleAnimation Storyboard.TargetName="ContentArea"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1"
                             BeginTime="0:0:0" Duration="0:0:0.4"/>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <!-- ============ Page1：欢迎首页 ============ -->
        <Grid x:Name="Page1" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <Image Source="pack://application:,,,/images/start.png"
                       Width="260" Height="260"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       Margin="-40,0,0,28"/>

                <TextBlock Text="泥嚎！"
                           FontFamily="Microsoft YaHei"
                           FontSize="40"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,14"
                           Foreground="#222222"/>

                <TextBlock Text="欢迎使用ShowWriteAir，接下来派蒙会带领你进行初步配置"
                           FontFamily="Microsoft YaHei"
                           FontSize="16"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="560"
                           Foreground="#333333"/>
            </StackPanel>

            <Button x:Name="StartButton"
                    Grid.Row="1"
                    Content="启动！"
                    Width="180" Height="46"
                    FontFamily="Microsoft YaHei"
                    FontSize="17"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,36"
                    Foreground="White"
                    BorderThickness="0"
                    Click="StartButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="startBtnBorder"
                                Background="#2980B9"
                                CornerRadius="23">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="startBtnBorder" Property="Background" Value="#1C6399"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="startBtnBorder" Property="Background" Value="#16527E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- ============ Page2：仿Windows8引导页 ============ -->
        <Grid x:Name="Page2" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：四个标题从右至左依次滑入 -->
            <StackPanel Grid.Column="0"
                        VerticalAlignment="Center"
                        Margin="48,0,0,0">
                <TextBlock x:Name="Title1" Text="欢迎"
                           FontFamily="Microsoft YaHei UI"
                           FontSize="38"
                           FontWeight="Light"
                           Foreground="#1F1F1F"
                           Margin="0,0,0,24"
                           Opacity="0">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="Title1Transform" X="400"/>
                    </TextBlock.RenderTransform>
                </TextBlock>

                <TextBlock x:Name="Title2" Text="基础"
                           FontFamily="Microsoft YaHei UI"
                           FontSize="38"
                           FontWeight="Light"
                           Foreground="#9A9A9A"
                           Margin="0,0,0,24"
                           Opacity="0">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="Title2Transform" X="400"/>
                    </TextBlock.RenderTransform>
                </TextBlock>

                <TextBlock x:Name="Title3" Text="个性化"
                           FontFamily="Microsoft YaHei UI"
                           FontSize="38"
                           FontWeight="Light"
                           Foreground="#9A9A9A"
                           Margin="0,0,0,24"
                           Opacity="0">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="Title3Transform" X="400"/>
                    </TextBlock.RenderTransform>
                </TextBlock>

                <TextBlock x:Name="Title4" Text="开始"
                           FontFamily="Microsoft YaHei UI"
                           FontSize="38"
                           FontWeight="Light"
                           Foreground="#9A9A9A"
                           Margin="0,0,0,0"
                           Opacity="0">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="Title4Transform" X="400"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </StackPanel>

            <!-- 右侧：内容区域（动画完成后显示） -->
            <Grid Grid.Column="1" x:Name="ContentArea" Opacity="0" Margin="40,48,48,48">

                <!-- ====== 欢迎内容（服务条款） ====== -->
                <Grid x:Name="WelcomeContent" Visibility="Visible">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="WelcomeContentTransform" Y="0"/>
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 内容标题 -->
                    <TextBlock Grid.Row="0" Text="欢迎使用。开始前，请阅读并同意我们的服务条款。"
                               FontFamily="Microsoft YaHei"
                               FontSize="22"
                               FontWeight="Light"
                               TextWrapping="Wrap"
                               Foreground="#222222"
                               Margin="0,0,0,20"/>

                    <!-- 服务条款正文（可滚动） -->
                    <Border Grid.Row="1"
                            Background="#FAFAFA"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="20,16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">

                        </ScrollViewer>
                    </Border>

                    <!-- 底部：同意复选框 + 下一步按钮 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,20,0,0">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,0,20,0">
                            <CheckBox x:Name="AgreeCheckBox"
                                      VerticalAlignment="Center"
                                      Padding="0"
                                      Checked="AgreeCheckBox_Changed"
                                      Unchecked="AgreeCheckBox_Changed"/>
                            <TextBlock Text="我同意服务条款"
                                       FontFamily="Microsoft YaHei"
                                       FontSize="14"
                                       Foreground="#333333"
                                       VerticalAlignment="Center"
                                       Margin="-80,0,0,0"/>
                        </StackPanel>
                        <Button x:Name="NextButton"
                                Content="下一步"
                                Width="120" Height="40"
                                FontFamily="Microsoft YaHei"
                                FontSize="15"
                                Foreground="White"
                                BorderThickness="0"
                                IsEnabled="False"
                                Click="NextButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="nextBtnBorder"
                                            Background="#2980B9"
                                            CornerRadius="20">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="nextBtnBorder" Property="Background" Value="#CCCCCC"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsEnabled" Value="True"/>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="nextBtnBorder" Property="Background" Value="#1C6399"/>
                                        </MultiTrigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsEnabled" Value="True"/>
                                                <Condition Property="IsPressed" Value="True"/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="nextBtnBorder" Property="Background" Value="#16527E"/>
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ====== 基础内容（摄像头预览 + 默认摄像头选择） ====== -->
                <Grid x:Name="BasicContent" Visibility="Collapsed">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="BasicContentTransform" Y="0"/>
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 内容标题 -->
                    <TextBlock Grid.Row="0" Text="基础设置。请选择您的默认摄像头，预览框将实时显示画面。"
                               FontFamily="Microsoft YaHei"
                               FontSize="22"
                               FontWeight="Light"
                               TextWrapping="Wrap"
                               Foreground="#222222"
                               Margin="0,0,0,20"/>

                    <!-- 预览框 + 摄像头选择 -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 摄像头预览框 -->
                        <Border Grid.Row="0"
                                Background="#1A1A1A"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1"
                                CornerRadius="4"
                                ClipToBounds="True">
                            <Grid>
                                <Image x:Name="CameraPreview" Stretch="Uniform"/>
                                <TextBlock x:Name="CameraPlaceholder"
                                           Text="未检测到摄像头"
                                           FontFamily="Microsoft YaHei"
                                           FontSize="16"
                                           Foreground="#888888"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <!-- 摄像头选择下拉框 -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="0,16,0,0">
                            <TextBlock Text="默认摄像头："
                                       FontFamily="Microsoft YaHei"
                                       FontSize="14"
                                       Foreground="#333333"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <ComboBox x:Name="CameraComboBox"
                                      Width="300" Height="32"
                                      FontFamily="Microsoft YaHei"
                                      FontSize="14"
                                      VerticalContentAlignment="Center"
                                      SelectionChanged="CameraComboBox_SelectionChanged"/>
                        </StackPanel>
                    </Grid>

                    <!-- 底部：上一步 + 下一步按钮 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,20,0,0">
                        <Button x:Name="BasicBackButton"
                                Content="上一步"
                                Width="120" Height="40"
                                FontFamily="Microsoft YaHei"
                                FontSize="15"
                                Foreground="#333333"
                                BorderThickness="1"
                                BorderBrush="#CCCCCC"
                                Margin="0,0,12,0"
                                Click="BasicBackButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="basicBackBtnBorder"
                                            Background="#FFFFFF"
                                            BorderBrush="#CCCCCC"
                                            BorderThickness="1"
                                            CornerRadius="20">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="basicBackBtnBorder" Property="Background" Value="#F5F5F5"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="basicBackBtnBorder" Property="Background" Value="#EAEAEA"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="BasicNextButton"
                                Content="下一步"
                                Width="120" Height="40"
                                FontFamily="Microsoft YaHei"
                                FontSize="15"
                                Foreground="White"
                                BorderThickness="0"
                                Click="BasicNextButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="basicNextBtnBorder"
                                            Background="#2980B9"
                                            CornerRadius="20">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="basicNextBtnBorder" Property="Background" Value="#1C6399"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="basicNextBtnBorder" Property="Background" Value="#16527E"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ====== 个性化内容（主题选择） ====== -->
                <Grid x:Name="PersonalizeContent" Visibility="Collapsed">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="PersonalizeContentTransform" Y="0"/>
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 内容标题 -->
                    <TextBlock Grid.Row="0" Text="个性化。选择您喜欢的主题外观。"
                               FontFamily="Microsoft YaHei"
                               FontSize="22"
                               FontWeight="Light"
                               TextWrapping="Wrap"
                               Foreground="#222222"
                               Margin="0,0,0,20"/>

                    <!-- 主题选择卡片 -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <!-- 浅色主题卡片 -->
                        <Border x:Name="LightThemeCard"
                                Width="180" Height="120"
                                Background="#FFFFFF"
                                BorderBrush="#2980B9"
                                BorderThickness="2"
                                CornerRadius="6"
                                Margin="0,0,20,0"
                                Cursor="Hand"
                                MouseLeftButtonDown="LightThemeCard_Click">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border Width="48" Height="48"
                                        Background="#F5F5F5"
                                        CornerRadius="24"
                                        Margin="0,0,0,8">
                                    <TextBlock Text="☀"
                                               FontSize="24"
                                               Foreground="#F39C12"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="浅色"
                                           FontFamily="Microsoft YaHei"
                                           FontSize="16"
                                           Foreground="#333333"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- 深色主题卡片 -->
                        <Border x:Name="DarkThemeCard"
                                Width="180" Height="120"
                                Background="#FFFFFF"
                                BorderBrush="#CCCCCC"
                                BorderThickness="2"
                                CornerRadius="6"
                                Cursor="Hand"
                                MouseLeftButtonDown="DarkThemeCard_Click">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border Width="48" Height="48"
                                        Background="#2C3E50"
                                        CornerRadius="24"
                                        Margin="0,0,0,8">
                                    <TextBlock Text="🌙"
                                               FontSize="24"
                                               Foreground="#ECF0F1"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="深色"
                                           FontFamily="Microsoft YaHei"
                                           FontSize="16"
                                           Foreground="#333333"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 底部：上一步 + 下一步按钮 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,20,0,0">
                        <Button x:Name="PersonalizeBackButton"
                                Content="上一步"
                                Width="120" Height="40"
                                FontFamily="Microsoft YaHei"
                                FontSize="15"
                                Foreground="#333333"
                                BorderThickness="1"
                                BorderBrush="#CCCCCC"
                                Margin="0,0,12,0"
                                Click="PersonalizeBackButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="personalizeBackBtnBorder"
                                            Background="#FFFFFF"
                                            BorderBrush="#CCCCCC"
                                            BorderThickness="1"
                                            CornerRadius="20">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="personalizeBackBtnBorder" Property="Background" Value="#F5F5F5"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="personalizeBackBtnBorder" Property="Background" Value="#EAEAEA"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="PersonalizeNextButton"
                                Content="下一步"
                                Width="120" Height="40"
                                FontFamily="Microsoft YaHei"
                                FontSize="15"
                                Foreground="White"
                                BorderThickness="0"
                                Click="PersonalizeNextButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="personalizeNextBtnBorder"
                                            Background="#2980B9"
                                            CornerRadius="20">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="personalizeNextBtnBorder" Property="Background" Value="#1C6399"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="personalizeNextBtnBorder" Property="Background" Value="#16527E"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ====== 完成内容（开始使用） ====== -->
                <Grid x:Name="CompleteContent" Visibility="Collapsed">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="CompleteContentTransform" Y="0"/>
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 居中：图片 + 标题 + 副标题 -->
                    <StackPanel Grid.Row="0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <Image Source="pack://application:,,,/images/end.png"
                               Width="200" Height="200"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,24"/>
                        <TextBlock Text="完成！"
                                   FontFamily="Microsoft YaHei"
                                   FontSize="32"
                                   FontWeight="Light"
                                   Foreground="#222222"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,12"/>
                        <TextBlock Text="开始您的使用"
                                   FontFamily="Microsoft YaHei"
                                   FontSize="18"
                                   FontWeight="Light"
                                   Foreground="#555555"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- 底部：上一步 + 开始使用按钮 -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,20,0,0">
                        <Button x:Name="CompleteBackButton"
                                Content="上一步"
                                Width="120" Height="40"
                                FontFamily="Microsoft YaHei"
                                FontSize="15"
                                Foreground="#333333"
                                BorderThickness="1"
                                BorderBrush="#CCCCCC"
                                Margin="0,0,12,0"
                                Click="CompleteBackButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="completeBackBtnBorder"
                                            Background="#FFFFFF"
                                            BorderBrush="#CCCCCC"
                                            BorderThickness="1"
                                            CornerRadius="20">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="completeBackBtnBorder" Property="Background" Value="#F5F5F5"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="completeBackBtnBorder" Property="Background" Value="#EAEAEA"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="StartUsingButton"
                                Content="开始使用"
                                Width="140" Height="40"
                                FontFamily="Microsoft YaHei"
                                FontSize="15"
                                Foreground="White"
                                BorderThickness="0"
                                Click="StartUsingButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="startUsingBtnBorder"
                                            Background="#27AE60"
                                            CornerRadius="20">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="startUsingBtnBorder" Property="Background" Value="#1F8B4D"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="startUsingBtnBorder" Property="Background" Value="#176E3C"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>

            </Grid>
        </Grid>
    </Grid>
</Window>
